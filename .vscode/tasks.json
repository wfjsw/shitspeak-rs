				"isDefault": true
			}
		},
		{
			"label": "cargo check",
			"type": "cargo",
			"command": "check",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "noop",
			"type": "shell",
			"command": "echo"
		},
		{
			"label": "noop2",
			"type": "shell",
			"command": "Write-Output",
			"args": [
				"ok"
			]
		}
	]
}